<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the mod's sampler (Source/LayoutModel.cs) outside the game on .NET Framework 4.8 and compares a
       deterministic sample with the Python reference (train/ort_reference.py). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\Source\LayoutModel.cs" />
    <Compile Include="..\..\Source\OnnxNative.cs" />
    <Reference Include="System.Runtime.Serialization" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.23.2" />
  </ItemGroup>
</Project>
